{
  "expo": {
    "name": "Sugo Rider",
    "slug": "RiderMobileApp",
    "version": "1.1.4",
    "orientation": "portrait",
    "scheme": "sugorider",
    "primaryColor": "#1E3A5F",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Sugo Rider"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.astrowarden.RiderMobileApp",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#DC2626",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-blank.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sugo Rider to use your location."
        }
      ],
      "expo-secure-store",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#DC2626"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sugo uses your photos so you can set a profile picture riders and dispatchers will recognise."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/275be8ea-14b0-4ac6-90dc-168df39618a1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": "1.1.4",
    "owner": "astrowarden",
    "extra": {
      "eas": {
        "projectId": "275be8ea-14b0-4ac6-90dc-168df39618a1"
      }
    }
  }
}
